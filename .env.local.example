# 카카오 개발자 사이트에서 발급: https://developers.kakao.com
#   1) 내 애플리케이션 > 애플리케이션 추가하기
#   2) [앱 키] 탭에서 두 개를 복사한다
#   3) 이 파일을 .env.local 로 복사해 값을 채운다
#   4) [플랫폼] > Web > 사이트 도메인에 http://localhost:3000 을 등록한다 (지도 SDK 에 필수)

# 지오코딩 스크립트(npm run geocode) 전용. 서버에서만 쓰고 브라우저로 내보내지 않는다.
KAKAO_REST_API_KEY=

# 지도 SDK 용. NEXT_PUBLIC_ 접두사라 브라우저에 노출된다 — 정상이며, 위 4)번 도메인 제한으로 보호한다.
NEXT_PUBLIC_KAKAO_MAP_KEY=
